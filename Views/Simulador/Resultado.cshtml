@{
    ViewBag.Title = "Resultado de Simulación";
    var pacientes = ViewBag.Pacientes as List<SimuladorEmergencias.Models.Paciente>;
    var gantt = ViewBag.Gantt as List<SimuladorEmergencias.Models.GanttEjecucion>;
    var reportes = ViewBag.Reportes as List<SimuladorEmergencias.Models.ReporteAlgoritmo>;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Resultado de la Simulación</h2>
        <div>
            <a asp-action="Index" class="btn btn-primary">← Nueva Simulación</a>
            <a asp-action="Limpiar" class="btn btn-danger ms-2">Limpiar</a>
        </div>
    </div>

    <!-- Estadísticas -->
    @if (reportes != null && reportes.Any())
    {
        <div class="card mb-4">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">Estadísticas del Algoritmo</h5>
            </div>
            <div class="card-body p-0">
                <table class="table table-bordered mb-0">
                    <thead class="table-secondary">
                        <tr>
                            <th>Algoritmo</th>
                            <th>Total Pacientes</th>
                            <th>Promedio Espera</th>
                            <th>Promedio Retorno</th>
                            <th>Utilización CPU</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in reportes)
                        {
                            <tr>
                                <td><span class="badge bg-primary">@r.Algoritmo</span></td>
                                <td>@r.TotalProcesos</td>
                                <td>@r.AvgEspera.ToString("F2")</td>
                                <td>@r.AvgRetorno.ToString("F2")</td>
                                <td>
                                    <div class="progress">
                                        <div class="progress-bar bg-success"
                                             style="width:@r.UtilizacionCpu.ToString("F0")%">
                                            @r.UtilizacionCpu.ToString("F1")%
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- Diagrama Gantt -->
    <div class="card mb-4">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">Diagrama de Gantt</h5>
        </div>
        <div class="card-body overflow-auto">
            @if (pacientes != null && pacientes.Any())
            {
                int tiempoMax = pacientes.Max(p => p.TiempoFin ?? 0);

                <div style="min-width: @(tiempoMax * 50)px">
                    <!-- Escala de tiempo -->
                    <div class="d-flex mb-1">
                        <div style="width:100px"></div>
                        @for (int t = 0; t <= tiempoMax; t++)
                        {
                            <div style="width:50px; font-size:11px; text-align:center">
                                @t
                            </div>
                        }
                    </div>

                    <!-- Barra por paciente -->
                    @foreach (var p in pacientes.OrderBy(p => p.TiempoInicio))
                    {
                        <div class="d-flex align-items-center mb-1">
                            <!-- Nombre -->
                            <div style="width:100px; font-size:12px; font-weight:bold"
                                 title="@p.Nombre">
                                @(p.Nombre?.Length > 10
                                                        ? p.Nombre.Substring(0, 10) + "…"
                                                        : p.Nombre)
                    </div>

                            <!-- Espacio vacío antes de iniciar -->
                            <div style="width:@((p.TiempoInicio ?? 0) * 50)px"></div>

                            <!-- Barra de ejecución -->
                            <div style="width:@(p.TiempoRafaga * 50)px;
                                                background-color:@(p.Tipo?.ColorHex ?? "#888");
                                                height:30px;
                                                border-radius:4px;
                                                display:flex;
                                                align-items:center;
                                                justify-content:center;
                                                color:white;
                                                font-size:11px;
                                                font-weight:bold;"
                                 title="Inicio: @p.TiempoInicio | Fin: @p.TiempoFin">
                                P@(p.IdPaciente)
                            </div>
                        </div>
                                }
                </div>
            }
            else
            {
                <p class="text-muted">No hay datos de Gantt disponibles.</p>
            }
        </div>
    </div>

    <!-- Tabla de resultados -->
    <div class="card">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">Detalle por Paciente</h5>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Nombre</th>
                        <th>Tipo</th>
                        <th>Llegada</th>
                        <th>Ráfaga</th>
                        <th>Inicio</th>
                        <th>Fin</th>
                        <th>Espera</th>
                        <th>Retorno</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in pacientes?.OrderBy(p => p.TiempoInicio)
                                        ?? Enumerable.Empty<SimuladorEmergencias.Models.Paciente>())
                    {
                        <tr>
                            <td>@p.IdPaciente</td>
                            <td>@p.Nombre</td>
                            <td>
                                <span class="badge"
                                      style="background-color:@p.Tipo?.ColorHex">
                                    @p.Tipo?.Nombre
                                </span>
                            </td>
                            <td>@p.TiempoLlegada</td>
                            <td>@p.TiempoRafaga</td>
                            <td>@p.TiempoInicio</td>
                            <td>@p.TiempoFin</td>
                            <td>@p.TiempoEspera</td>
                            <td>@p.TiempoRetorno</td>
                            <td>
                                <span class="badge bg-success">@p.Estado</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>