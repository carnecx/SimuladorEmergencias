@model SimuladorEmergencias.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";

    var finalizados = Model.Pacientes
        .Where(p => p.Estado == "finalizado")
        .ToList();
}

<div class="container mt-4">

    <h2 class="mb-4">Dashboard Centro de Emergencias</h2>

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <h5>Total Pacientes</h5>
                    <h2>@Model.TotalPacientes</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <h5>En Espera</h5>
                    <h2>@Model.PacientesEnEspera</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <h5>En Atención</h5>
                    <h2>@Model.PacientesEnAtencion</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <h5>Finalizados</h5>
                    <h2>@Model.PacientesFinalizados</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card border-primary">
                <div class="card-body">
                    <h5>Promedio Espera</h5>
                    <h3>@Model.PromedioEspera.ToString("0.00")</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-success">
                <div class="card-body">
                    <h5>Promedio Retorno</h5>
                    <h3>@Model.PromedioRetorno.ToString("0.00")</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-danger">
                <div class="card-body">
                    <h5>Utilización CPU</h5>
                    <h3>@Model.UtilizacionCpu.ToString("0.00")%</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow mt-4">
        <div class="card-header bg-dark text-white">
            <h4 class="mb-0">Pacientes registrados en la simulación</h4>
        </div>

        <div class="card-body">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Paciente</th>
                        <th>Tipo</th>
                        <th>Prioridad</th>
                        <th>Estado</th>
                        <th>Llegada</th>
                        <th>Ráfaga</th>
                        <th>Restante</th>
                        <th>Espera estimada</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var paciente in Model.Pacientes)
                    {
                        var colorTipo = paciente.Tipo?.ColorHex ?? "#6c757d";

                        string estadoClase = paciente.Estado switch
                        {
                            "esperando" => "bg-warning text-dark",
                            "en_atencion" => "bg-info text-dark",
                            "finalizado" => "bg-success",
                            _ => "bg-secondary"
                        };

                        string estadoTexto = paciente.Estado switch
                        {
                            "esperando" => "Esperando",
                            "en_atencion" => "En atención",
                            "finalizado" => "Finalizado",
                            _ => "Sin estado"
                        };

                        <tr>
                            <td>@paciente.IdPaciente</td>
                            <td>@paciente.Nombre</td>

                            <td>
                                <span class="badge" style="background-color:@colorTipo">
                                    @paciente.Tipo?.Nombre
                                </span>
                            </td>

                            <td>
                                <span class="badge bg-danger">
                                    Prioridad @paciente.Prioridad
                                </span>
                            </td>

                            <td>
                                <span class="badge @estadoClase">
                                    @estadoTexto
                                </span>
                            </td>

                            <td>@paciente.TiempoLlegada</td>
                            <td>@paciente.TiempoRafaga</td>
                            <td>@paciente.TiempoRestante</td>

                            <td>
                                @if (paciente.TiempoEspera.HasValue)
                                {
                                    <span>@paciente.TiempoEspera unidades</span>
                                }
                                else
                                {
                                    <span class="text-muted">Pendiente</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card shadow mt-4">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Reporte comparativo por algoritmo</h4>
        </div>

        <div class="card-body">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Cola</th>
                        <th>Algoritmo</th>
                        <th>Espera promedio</th>
                        <th>Retorno promedio</th>
                        <th>Utilización CPU</th>
                        <th>Total procesos</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var reporte in Model.Reportes)
                    {
                        <tr>
                            <td>@reporte.NombreCola</td>
                            <td>
                                <span class="badge bg-dark">@reporte.Algoritmo</span>
                            </td>
                            <td>@reporte.AvgEspera.ToString("0.00")</td>
                            <td>@reporte.AvgRetorno.ToString("0.00")</td>
                            <td>@reporte.UtilizacionCpu.ToString("0.00")%</td>
                            <td>@reporte.TotalProcesos</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card shadow mt-4 mb-4">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0">Historial de pacientes finalizados</h4>
        </div>

        <div class="card-body">
            @if (finalizados.Any())
            {
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Paciente</th>
                            <th>Tipo</th>
                            <th>Prioridad</th>
                            <th>Tiempo espera</th>
                            <th>Tiempo retorno</th>
                            <th>Tiempo fin</th>
                            <th>Estado</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var paciente in finalizados)
                        {
                            <tr>
                                <td>@paciente.Nombre</td>
                                <td>@paciente.Tipo?.Nombre</td>
                                <td>@paciente.Prioridad</td>
                                <td>@paciente.TiempoEspera</td>
                                <td>@paciente.TiempoRetorno</td>
                                <td>@paciente.TiempoFin</td>
                                <td>
                                    <span class="badge bg-success">
                                        Finalizado
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-warning mb-0">
                    Aún no hay pacientes finalizados.
                </div>
            }
        </div>
    </div>
    <div class="card shadow mt-4 mb-4">
        <div class="card-header bg-secondary text-white">
            <h4 class="mb-0">Visualización de Colas</h4>
        </div>

        <div class="card-body">

            <div class="row">

                @foreach (var grupo in Model.Pacientes.GroupBy(p => p.Tipo?.Nombre))
                {
                    <div class="col-md-4 mb-3">

                        <div class="card border-dark h-100">

                            <div class="card-header">
                                <strong>@grupo.Key</strong>
                            </div>

                            <div class="card-body">

                                @foreach (var paciente in grupo)
                                {
                                    <div class="mb-2">
                                        <span class="badge bg-primary">
                                            @paciente.Nombre
                                        </span>
                                    </div>
                                }

                            </div>

                        </div>

                    </div>
                }

            </div>

        </div>
    </div>
</div>